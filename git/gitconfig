# git/setup.sh が ~/.gitconfig の include.path に追加して読み込ませる
# 作成者の情報は個人情報なのでここには置かず、~/.gitconfig に直接書く

[init]
	# git init したときのブランチ名
	defaultBranch = main

[pull]
	# pull でマージコミットを作らず、リベースする
	rebase = true

[push]
	# 初回の push で上流ブランチを自動で設定する
	autoSetupRemote = true

[core]
	# コミットメッセージなどを書くエディタ
	editor = vim
	# 全体の ignore は既定の ~/.config/git/ignore を読むので excludesfile は設定しない
	# （git/setup.sh が git/gitignore_global をそこへリンクする）

[fetch]
	# fetch / pull のときに、リモートで削除されたブランチの追跡ブランチ（origin/foo など）を消す
	prune = true

[diff]
	# 行の移動や似た行が多いときに、デフォルトの myers より読みやすい差分を出す
	algorithm = histogram

[merge]
	# コンフリクト箇所に、両方の変更に加えて元の内容（共通の祖先）も表示する
	conflictstyle = zdiff3

[rerere]
	# 一度解決したコンフリクトの解決方法を記録し、同じコンフリクトが再び起きたら自動で適用する
	enabled = true
