# アプリを Homebrew でインストールする
# 使い方: brew bundle --file=Brewfile
# yabai / skhd / dockutil は yabai/setup.sh と macos/dock.sh でインストールするのでここには書かない

brew "git"                # Git
brew "gh"                 # GitHub CLI（ssh 鍵の登録にも使う）
brew "uv"                 # Python のパッケージ・プロジェクト管理
brew "pipx"               # Python 製の CLI ツールを個別の環境にインストール
brew "node"               # Node.js（Slidev などの JavaScript 製ツールの実行環境）
brew "pnpm"               # Node.js のパッケージ管理（Slidev 公式の推奨）
brew "tailscale"          # VPN（外から自宅の Mac に ssh する。GUI なしのデーモン版。起動とログインは tailscale/setup.sh）
brew "fzf"                # あいまい検索（Ctrl-R で履歴、Ctrl-T でファイル、Alt-C でディレクトリ移動。zsh/zshrc.local で有効にする）
brew "poppler"            # PDF を文字にする（pdftotext・pdftoppm。Claude Code の imozuru スキルが論文を読むのに使う）
brew "tesseract"          # OCR（文字の層が無いスキャン PDF を imozuru が読むのに使う。英語のみ）

cask "google-chrome"      # /Applications/Google Chrome.app
cask "discord"            # /Applications/Discord.app
cask "slack"              # /Applications/Slack.app
cask "coteditor"          # /Applications/CotEditor.app
cask "claude"             # /Applications/Claude.app
cask "bricklink-studio"   # /Applications/Studio 2.0/Studio.app（pkg でインストール）
cask "ghostty"            # /Applications/Ghostty.app
cask "orbstack"           # /Applications/OrbStack.app（Docker の実行環境。docker コマンドも入る）
